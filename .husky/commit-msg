#!/bin/sh
# Husky + Entire + truth-mirror chain.
#
# Layering (2026-08-22): .husky/_/<hook> stays the bare husky shim; the truth
# gate lives here. Entire's git dispatch is intentionally NOT folded into this
# file - invoking `entire hooks git <hook>` from a content hook makes Entire
# self-heal its wrappers over the shim entries, which breaks husky's $0-derived
# lookup and silently skips this gate (the onyxio "foundry finding"). Entire
# keeps its own entries for prepare-commit-msg / post-rewrite / post-checkout,
# where truth claims no hook. If `entire enable --force` is rerun it will
# re-wrap these entries - restore the bare shims afterwards.

# truth-mirror managed hook
if command -v truth-mirror >/dev/null 2>&1; then truth-mirror hook-dispatch commit-msg "$@"; else :; fi
# truth-mirror hook end
