#!/bin/sh
# Husky -> truth-mirror gate (strict).
#
# open-quake hardening (2026-08-22, adversarial-review finding on ca2eae7):
# the upstream-managed body's `else :` fallback allowed commits when
# truth-mirror was off PATH. The preamble below resolves the vendored binary
# (mise.toml pins cargo:truth-mirror) and DENIES the commit if it cannot be
# found, per .truth/TRUTH.md. Keep the managed dispatch line literal so
# `truth status` continues to recognize this hook.

# Ensure mise shims are on PATH so the vendored truth-mirror resolves.
_mise_shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
[ -d "$_mise_shims" ] && PATH="$_mise_shims:$PATH" && export PATH

if ! command -v truth-mirror >/dev/null 2>&1; then
	echo "commit-msg blocked: truth-mirror not resolvable - run 'mise install' (see mise.toml)" >&2
	exit 1
fi

# truth-mirror managed hook
truth-mirror hook-dispatch commit-msg "$@"
# truth-mirror hook end
