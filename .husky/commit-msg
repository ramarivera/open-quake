#!/bin/sh
# Husky -> truth-mirror gate (strict).
#
# open-quake hardening (2026-08-22, adversarial-review findings on ca2eae7 and
# cf53aee): the upstream-managed body allowed commits when truth-mirror was off
# PATH or when TRUTH_MIRROR_STATE_DIR pointed at absent state. This hook pins
# the vendored binary (mise.toml) and the repo-owned state dir, and DENIES the
# protected operation when either is unavailable, per .truth/TRUTH.md. Keep the
# managed dispatch line literal so `truth status` recognizes this hook.

# Ensure mise shims are on PATH so the vendored truth-mirror resolves.
_mise_shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
[ -d "$_mise_shims" ] && PATH="$_mise_shims:$PATH" && export PATH

if ! command -v truth-mirror >/dev/null 2>&1; then
	echo "commit-msg blocked: truth-mirror not resolvable - run 'mise install' (see mise.toml)" >&2
	exit 1
fi

if [ ! -f ".truth/config.toml" ]; then
	echo "commit-msg blocked: .truth/config.toml missing - commit denied" >&2
	exit 1
fi
unset TRUTH_MIRROR_STATE_DIR

# truth-mirror managed hook
truth-mirror --state-dir .truth hook-dispatch commit-msg "$@"
# truth-mirror hook end
