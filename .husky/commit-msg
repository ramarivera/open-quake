#!/bin/sh
# commit-msg - gates first (immediate exit on error), then Beads, Entire and
# Truth Mirror run sequentially with saved statuses; the commit is rejected if
# any consumer errored. Husky is the sole hook owner; entries in .husky/_ are
# bare shims.

# Repository gates: none configured yet. Add them here with `|| exit 1`.

. "$(dirname "$0")/hook-consumers.sh"
entire_status=0
truth_status=0
# NOTE: beads has no commit-msg hook (bd hooks list) - consumers are Entire +
# Truth Mirror only on this hook.
run_entire_hook commit-msg "$@" || entire_status=$?
if ensure_truth_ready commit-msg; then
	truth-mirror --state-dir .truth hook-dispatch commit-msg "$@" || truth_status=$?
else
	truth_status=1
fi
finish_shared_hook_consumers commit-msg "$entire_status" "$truth_status"
