#!/bin/sh
# Entire CLI hooks (folded into the husky content hook - see .husky/commit-msg)
if command -v entire >/dev/null 2>&1; then entire hooks git post-commit 2>/dev/null || true; else :; fi

# truth-mirror managed hook
if command -v truth-mirror >/dev/null 2>&1; then truth-mirror hook-dispatch post-commit "$@"; else :; fi
# truth-mirror hook end
