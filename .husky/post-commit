#!/bin/sh
# post-commit - gates first (fail fast), then Entire + Truth Mirror.
# Husky is the sole hook owner; entries in .husky/_ are bare shims.

# Repository gates: none configured yet. Add them here with `|| exit 1`.

. "$(dirname "$0")/hook-consumers.sh"
entire_status=0
truth_status=0
run_entire_hook post-commit "$@" || entire_status=$?
if ensure_truth_ready post-commit; then
	truth-mirror --state-dir .truth hook-dispatch post-commit "$@" || truth_status=$?
else
	truth_status=1
fi
finish_shared_hook_consumers post-commit "$entire_status" "$truth_status"
