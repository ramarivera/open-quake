#!/bin/sh
# post-checkout - propagate local-only skills into fresh worktrees.
#
# .agents/skills/dark-encyclopedia is deliberately gitignored (blanket
# .gitignore inside the folder - Ramiro wants it local-only, never
# distributed), so a new worktree checkout never contains it. Git fires this
# hook on `git worktree add`; copy the folder from the main working tree when
# it is missing. Convenience sync, not an enforcement gate: failures warn but
# never block (exit 0).

main_tree="$(dirname "$(git rev-parse --git-common-dir 2>/dev/null)")"
src="$main_tree/.agents/skills"
dst="$(git rev-parse --show-toplevel)/.agents/skills"

if [ ! -d "$src" ]; then
	exit 0
fi

mkdir -p "$dst" || exit 0
for skill_dir in "$src"/*/; do
	name="$(basename "$skill_dir")"
	if [ ! -e "$dst/$name" ] && [ "$name" != "*" ]; then
		cp -R "$skill_dir" "$dst/$name" ||
			echo "post-checkout: failed to copy local-only skill '$name' into worktree" >&2
	fi
done
exit 0
