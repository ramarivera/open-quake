#!/bin/sh
# post-checkout - propagate LOCAL-ONLY skills into fresh worktrees.
#
# .agents/skills/dark-encyclopedia is deliberately gitignored (blanket
# .gitignore inside the folder - Ramiro wants it local-only, never
# distributed), so a new worktree checkout never contains it. Git fires this
# hook on `git worktree add`; copy ignored paths from the main working tree
# when missing. Tracked skills are NEVER copied - revision ownership is
# decided solely by the checked-out commit.
#
# Policy (recorded in .truth/TRUTH.md): this is BEST-EFFORT convenience, not
# an enforcement gate. If propagation fails the worktree simply lacks the
# local skill; checkout still succeeds.

# First resolve paths using the invoking (target-worktree) Git context.
main_tree="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")"
src_rel=".agents/skills"
src="$main_tree/$src_rel"
dst="$(git rev-parse --show-toplevel)/$src_rel"

# Checkouts inside the main tree itself have nothing to propagate.
[ "$src" = "$dst" ] && exit 0

# All queries below target the MAIN tree, but git exports GIT_DIR & co.
# pointing at the newly checked-out worktree. Drop them so ls-files /
# check-ignore consult the main tree's index and ignore rules, not the
# target revision's (review finding on c8b08f3).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR \
	GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES 2>/dev/null || true

if [ ! -d "$src" ]; then
	exit 0
fi

mkdir -p "$dst" || exit 0
for skill_dir in "$src"/*/; do
	name="$(basename "$skill_dir")"
	[ "$name" = "*" ] && continue
	# Qualification (BOTH must hold):
	#   1. no tracked path anywhere beneath the folder (mixed tracked+ignored
	#      directories stay revision-owned), AND
	#   2. git check-ignore confirms the folder's SKILL.md is explicitly
	#      ignored (plain untracked-but-not-ignored folders do not qualify).
	if [ -n "$(git -C "$main_tree" ls-files -- "$src_rel/$name")" ]; then
		continue
	fi
	git -C "$main_tree" check-ignore -q -- "$src_rel/$name/SKILL.md" || continue
	# Copy ONLY the individual paths git confirms ignored - never the whole
	# folder - so an ignored SKILL.md cannot smuggle unignored sibling files
	# (e.g. secrets) into other worktrees.
	skill_dst="$dst/$name"
	find "$skill_dir" -type f | while IFS= read -r file; do
		rel="${file#"$skill_dir"}"
		rel="${rel#/}"
		if git -C "$main_tree" check-ignore -q -- "$src_rel/$name/$rel"; then
			mkdir -p "$skill_dst/$(dirname "$rel")" ||
				{ echo "post-checkout: cannot create $skill_dst (best-effort)" >&2; continue; }
			cp "$file" "$skill_dst/$rel" ||
				echo "post-checkout: failed to copy '$name/$rel' into worktree (best-effort)" >&2
		else
			echo "post-checkout: skipped non-ignored file '$name/$rel'" >&2
		fi
	done
done
exit 0
