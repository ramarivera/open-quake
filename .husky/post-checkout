#!/bin/sh
# post-checkout - propagate LOCAL-ONLY skills into fresh worktrees.
#
# .agents/skills/dark-encyclopedia is deliberately gitignored (blanket
# .gitignore inside the folder - Ramiro wants it local-only, never
# distributed), so a new worktree checkout never contains it. Git fires this
# hook on `git worktree add`; copy ignored skill folders from the main working
# tree when missing. Tracked skills are NEVER copied - revision ownership is
# decided solely by the checked-out commit.
#
# Policy (recorded in .truth/TRUTH.md): this is BEST-EFFORT convenience, not
# an enforcement gate. If propagation fails the worktree simply lacks the
# local skill; checkout still succeeds.

main_tree="$(dirname "$(git rev-parse --git-common-dir 2>/dev/null)")"
src_rel=".agents/skills"
src="$main_tree/$src_rel"
dst="$(git rev-parse --show-toplevel)/$src_rel"

if [ ! -d "$src" ]; then
	exit 0
fi

mkdir -p "$dst" || exit 0
for skill_dir in "$src"/*/; do
	name="$(basename "$skill_dir")"
	[ "$name" = "*" ] && continue
	# Copy only genuinely local-only skills. BOTH predicates must hold:
	#   1. no tracked path anywhere beneath the folder (mixed tracked+ignored
	#      directories stay revision-owned), AND
	#   2. git check-ignore confirms the folder's SKILL.md is explicitly
	#      ignored (plain untracked-but-not-ignored folders do not qualify).
	if [ -n "$(git -C "$main_tree" ls-files -- "$src_rel/$name")" ]; then
		continue
	fi
	git -C "$main_tree" check-ignore -q -- "$src_rel/$name/SKILL.md" || continue
	if [ ! -e "$dst/$name" ]; then
		cp -R "$skill_dir" "$dst/$name" ||
			echo "post-checkout: failed to copy local-only skill '$name' into worktree (best-effort)" >&2
	fi
done
exit 0
