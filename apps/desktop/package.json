{
	"name": "@open-quake/desktop",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"build": "electron-vite build",
		"dev": "electron-vite dev",
		"test": "vitest run",
		"test:hardware": "vitest run --config hardware.e2e.config.ts",
		"test:bundle": "node src/main/test/bundle-smoke.mjs",
		"typecheck": "tsc --noEmit",
		"package": "electron-builder --config electron-builder.config.cjs --publish never",
		"test:release": "node --test scripts/release.test.mjs scripts/apple-signing.test.mjs",
		"test:package": "node scripts/smoke-package.mjs"
	},
	"dependencies": {
		"@open-quake/device": "workspace:*",
		"@open-quake/edge": "workspace:*",
		"@zip.js/zip.js": "2.24.0",
		"effect": "catalog:",
		"gt-react": "11.4.16",
		"koffi": "3.3.3",
		"node-hid": "3.4.0",
		"pino": "10.4.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@mdi/svg": "7.4.47",
		"@open-quake/protocol": "workspace:*",
		"@phosphor-icons/core": "2.1.1",
		"@types/node": "catalog:",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.1.0",
		"electron": "43.4.1",
		"electron-builder": "26.18.0",
		"electron-vite": "5.0.0",
		"happy-dom": "21.0.4",
		"typescript": "5.9.3",
		"vite": "8.2.2",
		"vitest": "catalog:"
	},
	"description": "Open-source desktop controller for the DecoKee QUAKE",
	"author": "Ramiro Rivera <ramarivera@users.noreply.github.com>",
	"homepage": "https://github.com/ramarivera/open-quake"
}
